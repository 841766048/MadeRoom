{
  "hosting": {
    "site": "made-room-20261009",
    "public": ".firebase-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/editorial/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/catalog/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=300"
          }
        ]
      }
    ],
    "predeploy": [
      "python3 tools/prepare_hosting.py"
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "anonymous": false
    }
  },
  "emulators": {
    "auth": {
      "port": 9098
    },
    "ui": {
      "enabled": false
    },
    "firestore": {
      "port": 8188
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
